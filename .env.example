# --- Auth / RBAC ---
# All values below must be SINGLE-LINE, unquoted, and contain no '#'.
# scripts/*.js parse .env.local with /^([A-Z0-9_]+)=(.*)$/.
# Next's own env loader also runs dotenv-expand over this file, which treats `$word` as a
# variable reference and silently strips it — avoid unescaped '$' in any value here (this is
# why password hashes below use '.' as a delimiter instead of the traditional '$').

# >= 32 chars. Generate with: openssl rand -hex 32
# NOTE: this is inlined into the Edge middleware bundle at build time —
# rotating it requires a REDEPLOY, not just an env-var update.
AUTH_SECRET=

SESSION_TTL_HOURS=12

# Optional. Falls back to the three built-in branch ids if unset.
ACADEMY_BRANCHES=[{"id":"BRANCH_SAIBABA","name":"Saibaba Colony"},{"id":"BRANCH_SOWRIPALAYAM","name":"Sowripalayam"},{"id":"BRANCH_KUNIYAMUTHUR","name":"Kuniyamuthur"}]

# Required. Generate each passwordHash with: node scripts/hash-password.js 'the-password'
# NOTE: the hash is `.`-delimited (scrypt.N.r.p.salt.hash), not `$`-delimited — Next's env
# loader runs dotenv-expand over every value here and silently strips `$word` sequences.
ACADEMY_USERS=[{"email":"admin.saibaba@darklight.in","name":"Admin A","role":"admin","branch":"BRANCH_SAIBABA","passwordHash":"scrypt.16384.8.1.SALT.HASH"},{"email":"admin.sowripalayam@darklight.in","name":"Admin B","role":"admin","branch":"BRANCH_SOWRIPALAYAM","passwordHash":"scrypt.16384.8.1.SALT.HASH"},{"email":"manikandan@darklight.in","name":"Manikandan","role":"superadmin","branch":"BRANCH_KUNIYAMUTHUR","passwordHash":"scrypt.16384.8.1.SALT.HASH"}]

# Optional alternative to ACADEMY_USERS: base64 of the same JSON, for pasting into the Vercel UI.
ACADEMY_USERS_B64=

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Google Calendar / Meet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Security
CRON_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Lead capture: one secret per branch. The secret IS the branch claim —
# a 'branch' field in the webhook payload is never trusted.
LEAD_WEBHOOK_SECRETS={"replace-with-secret-1":"BRANCH_SAIBABA","replace-with-secret-2":"BRANCH_SOWRIPALAYAM","replace-with-secret-3":"BRANCH_KUNIYAMUTHUR"}

# Legacy single secret. Still accepted; attributed to BACKFILL_DEFAULT_BRANCH.
LEAD_WEBHOOK_SECRET=

# Branch assigned to records that cannot be classified (scripts + legacy webhook).
BACKFILL_DEFAULT_BRANCH=BRANCH_KUNIYAMUTHUR

# Optional. Used by scripts/backfill-branch.js to map an existing coach name to a branch.
COACH_BRANCH_MAP={"Manikandan":"BRANCH_KUNIYAMUTHUR"}

# Coach assignment (lead-capture webhook) — optional JSON array of Coach objects,
# defaults to a single built-in coach if unset
COACH_POOL=
